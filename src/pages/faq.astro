---
import Base from "../layouts/Base.astro";
import faqData from "../data/faq.json";
const faqs = faqData.faqs;
---
<Base title="Frequently Asked Questions" active="FAQ">
  <section>
    <div class="wrap" style="max-width: 820px;">
      <span class="eyebrow">Good to know</span>
      <h1>Frequently asked questions</h1>
      <p style="max-width: 40em;">Everything travelers usually want to know before we start planning together. Don't see your question? <a href="/contact">Just ask me</a>.</p>
      <div class="faq-list" style="margin-top: 32px;">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <div style="margin-top: 36px; display: flex; gap: 12px; flex-wrap: wrap;">
        <a class="btn" href="/contact">Plan my trip</a>
        <a class="btn btn-ghost" href="/about">More about me</a>
      </div>
    </div>
  </section>
</Base>
