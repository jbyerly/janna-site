---
import Base from "../layouts/Base.astro";
import settings from "../data/settings.json";
import videoData from "../data/videos.json";
import faqData from "../data/faq.json";
import testimonialData from "../data/testimonials.json";

const partners = [
  ["Walt Disney World", "/logos/disney.svg"],
  ["Universal Orlando Resort", "/logos/universal.png"],
  ["SeaWorld", "/logos/seaworld.svg"],
  ["Norwegian Cruise Line", "/logos/norwegian.svg"],
  ["Carnival Cruise Line", "/logos/carnival.svg"],
  ["Royal Caribbean", "/logos/royal.svg"],
  ["Iberostar Hotels & Resorts", "/logos/iberostar.png"],
  ["Beaches Resorts", "/logos/beaches.svg"],
  ["Sandals Resorts", "/logos/sandals.svg"],
  ["Apple Vacations", "/logos/apple.png"],
  ["Funjet Vacations", "/logos/funjet.png"],
];

const latestVideo = videoData.videos[0];
const faqTeaser = faqData.faqs.slice(0, 3);
const testimonials = testimonialData.testimonials.slice(0, 3);
---
<Base title="Janna Lyn — Travel Advisor" active="Home">
  <header class="hero">
    <img
      class="hero-bg"
      src="/images/hero-aerial-1920.jpg"
      srcset="/images/hero-aerial-1200.jpg 1200w, /images/hero-aerial-1920.jpg 1920w"
      sizes="100vw"
      alt=""
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-content">
      <span class="eyebrow" style="color:#AEE6F5;">Cruises · Disney · Universal · Beyond</span>
      <h1>Adventures planned <em>around you.</em></h1>
      <p class="lede">
        Hi, I'm Janna Lyn! I turn "someday" trips into "remember when" stories —
        cruises, theme parks, and bucket-list getaways, planned down to the last detail
        (flight delays excluded — nobody can plan around those).
      </p>
      <div class="hero-cta">
        <a class="btn" href="/contact">Plan my trip</a>
        <a class="btn btn-ghost" href="/videos">Watch my ship tours</a>
      </div>
    </div>
    <div
      class="logo-marquee"
      role="img"
      aria-label="Some of the travel brands Janna books: Walt Disney World, Universal, SeaWorld, Norwegian Cruise Line, Carnival, Royal Caribbean, Iberostar, Beaches, Sandals, Apple Vacations, and Funjet"
    >
      <div class="marquee-track">
        {partners.map(([name, src]) => <img src={src} alt="" title={name} loading="lazy" />)}
        {partners.map(([name, src]) => <img src={src} alt="" title={name} loading="lazy" aria-hidden="true" />)}
      </div>
    </div>
  </header>

  <section>
    <div class="wrap">
      <span class="eyebrow">Why travel with me</span>
      <h2>A planner by passion, <br />an advisor by profession.</h2>
      <div class="card-grid" style="margin-top: 32px;">
        <div class="card"><div class="card-body">
          <div class="meta">Since 2017</div>
          <h3>Real experience, not brochures</h3>
          <p>Most of the Caribbean, several European countries, 28 states — plus Disney and Universal specialist training. I've been where I'm sending you.</p>
        </div></div>
        <div class="card"><div class="card-body">
          <div class="meta">Cruise lover</div>
          <h3>Ship tours before you sail</h3>
          <p>Walk through the actual ship on my YouTube channel before you book — dining, decks, and staterooms, no surprises.</p>
        </div></div>
        <div class="card"><div class="card-body">
          <div class="meta">Zero extra cost</div>
          <h3>My planning is free to you</h3>
          <p>Travel advisors are paid by the travel companies, not by you. You get an expert in your corner for the same price as booking it yourself.</p>
        </div></div>
      </div>
    </div>
  </section>

  {latestVideo && (
    <section class="alt">
      <div class="wrap">
        <span class="eyebrow">Fresh off the ship</span>
        <h2>Watch the latest walkthrough</h2>
        <div class="split" style="margin-top: 32px;">
          <div class="video-embed">
            <iframe src={`https://www.youtube.com/embed/${latestVideo.id}`} title={latestVideo.title}
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen loading="lazy"></iframe>
          </div>
          <div>
            <h3>{latestVideo.title}</h3>
            {latestVideo.note && <p>{latestVideo.note}</p>}
            <div style="margin-top: 18px; display: flex; gap: 12px; flex-wrap: wrap;">
              <a class="btn" href="/videos">Watch all videos</a>
              <a class="btn btn-ghost" href={settings.youtube_url} target="_blank" rel="noopener">Subscribe on YouTube</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <section>
    <div class="wrap split">
      <div>
        <span class="eyebrow">Meet your advisor</span>
        <h2>Hi, I'm Janna Lyn!</h2>
        <p>Travel advisor by profession, professional over-planner by nature. I've been exploring since I was a kid and planning trips for others since 2017 — most of the Caribbean, several European countries, 28 states, and more Disney and Universal visits than I can count.</p>
        <p>I plan every trip like it's my own family's vacation. Let's make yours unforgettable.</p>
        <a class="btn btn-ghost" href="/about" style="margin-top: 12px;">More about me</a>
      </div>
      <img src="/images/Janna-Dollywood-2-scaled.jpg" alt="Janna Lyn" loading="lazy" />
    </div>
  </section>

  <!-- PLACEHOLDER TESTIMONIALS: Janna, replace these with real client quotes in the site editor (Testimonials) before relying on them. -->
  <section class="alt">
    <div class="wrap">
      <span class="eyebrow">Kind words</span>
      <h2>Travelers I've helped</h2>
      <div class="card-grid" style="margin-top: 32px;">
        {testimonials.map((t) => (
          <div class="card"><div class="card-body">
            <div class="meta">{t.trip}</div>
            <p>&ldquo;{t.quote}&rdquo;</p>
            <p style="margin-top: 14px;"><strong>— {t.name}</strong></p>
          </div></div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap" style="max-width: 820px;">
      <span class="eyebrow">Good to know</span>
      <h2>Questions? Answers.</h2>
      <div class="faq-list" style="margin-top: 8px;">
        {faqTeaser.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <a class="btn" href="/faq" style="margin-top: 24px;">Read all FAQs</a>
    </div>
  </section>

  <section class="alt">
    <div class="wrap split">
      <img src="/images/20220501_081921-scaled.jpg" alt="Janna Lyn traveling" loading="lazy" />
      <div>
        <span class="eyebrow">From the blog</span>
        <h2>Stories from the road</h2>
        <p>Trip reports, ship walkthroughs, and the honest details — like what the food is <em>really</em> like on the Galactic Starcruiser.</p>
        <a class="btn btn-ghost" href="/blog" style="margin-top: 12px;">Read the blog</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="band">
        <span class="eyebrow" style="color:#AEE6F5;">Wander notes</span>
        <h2>Travel inspiration, once a month</h2>
        <p>Deals, destination guides, and stories — straight to your inbox. Unsubscribe anytime.</p>
        <form class="inline-form" data-newsletter>
          <input type="email" name="email" placeholder="Your email address" required aria-label="Email address" />
          <button class="btn" type="submit">Sign me up</button>
          <div class="cf-turnstile" data-sitekey={settings.turnstile_site_key}></div>
        </form>
        <p class="form-note" data-newsletter-status></p>
      </div>
    </div>
  </section>
</Base>
